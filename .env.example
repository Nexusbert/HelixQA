APP_NAME=HelixQA
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=your-secret-key-min-32-chars-for-production

# Database
DATABASE_URL=postgresql+asyncpg://helixqa:helixqa_pass@localhost:5432/helixqa_db
POSTGRES_USER=helixqa
POSTGRES_PASSWORD=helixqa_pass
POSTGRES_DB=helixqa_db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Providers (set only what you use; others can be empty)
AI_DEFAULT_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# OAuth (optional, stubs return 501 if not configured)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# External Scanners
SEMGREP_APP_TOKEN=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
